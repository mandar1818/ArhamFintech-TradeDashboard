# Backend Environment Configuration
APP_NAME="Arham Fintech BSE Trade Dashboard API"
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/trades.db
SEED_TRADE_COUNT=3250

# Set to 900 (15 minutes) to match exchange latency, or 10-20 for quick testing.
BSE_PULL_DELAY_SECONDS=900
BSE_DEFAULT_BATCH_SIZE=50
BSE_MAX_RETRIES=2
BSE_RETRY_DELAY_SECONDS=2.0

SSE_HEARTBEAT_SECONDS=15.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
