# ==============================================================================
# Arham Fintech - BSE Trade Operations Dashboard Configuration
# Copy to backend/.env and frontend/.env (or root .env) and adjust as needed.
# ==============================================================================

# --- Application ---
APP_NAME="Arham Fintech BSE Trade Dashboard API"
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (SQLite) ---
# Relative paths are resolved from the backend working directory.
DATABASE_URL=sqlite:///./data/trades.db

# --- Initial Seed Configuration ---
# Minimum 3,000 realistic Indian equity trades are seeded automatically if empty.
SEED_TRADE_COUNT=3250

# --- BSE Mock Ingestion & Delay Configuration ---
# Production/assessment default is 900 seconds (15 minutes).
# For local development or manual verification, set to 10-20 seconds (e.g. 15).
BSE_PULL_DELAY_SECONDS=900
BSE_DEFAULT_BATCH_SIZE=50
BSE_MAX_RETRIES=2
BSE_RETRY_DELAY_SECONDS=2.0

# --- Server-Sent Events (SSE) ---
SSE_HEARTBEAT_SECONDS=15.0

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
